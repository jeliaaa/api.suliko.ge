# ===========================================================================
# Suliko Office API — environment
#
# Copy to `.env` in this directory. NEVER commit a filled-in `.env`.
#
# This ONE file is read by two things:
#   - the application (pydantic-settings)
#   - docker compose, for the POSTGRES_* / REDIS_* values below
#
# So the database password you set here is both what Docker creates the server
# with AND what the app connects with. Change it in one place.
#
# Third-party service keys (Bank of Georgia, SMS, ElevenLabs,
# API24, reCAPTCHA) do NOT belong here. They are per-tenant, entered through
# Settings -> Integrations, and stored encrypted in the database.
# See docs/EXTERNAL-SERVICES.md §3.
# ===========================================================================

# ── Environment ────────────────────────────────────────────────────────────
ENVIRONMENT=production           # development | staging | production
DEBUG=false                      # must be false in production

# ── Docker: PostgreSQL ─────────────────────────────────────────────────────
# Host ports default to NON-standard values (5433 / 6380) so they cannot
# collide with a PostgreSQL or Redis already running on this server. Change
# them only if those are taken too. Both bind to 127.0.0.1 only.
POSTGRES_USER=suliko
POSTGRES_PASSWORD=               # generate a long random password
POSTGRES_DB=suliko
POSTGRES_HOST_PORT=5433

# ── Docker: Redis ──────────────────────────────────────────────────────────
REDIS_PASSWORD=                  # generate a long random password
REDIS_HOST_PORT=6380

# ── Application: database ──────────────────────────────────────────────────
# Must use the asyncpg driver and must match the POSTGRES_* values above,
# including the host port.
DATABASE_URL=postgresql+asyncpg://suliko:SAME-AS-POSTGRES_PASSWORD@127.0.0.1:5433/suliko

# ── Application: Redis ─────────────────────────────────────────────────────
# Must match REDIS_PASSWORD and REDIS_HOST_PORT above.
# With Redis configured, do NOT set RATE_LIMIT_SINGLE_INSTANCE.
REDIS_URL=redis://:SAME-AS-REDIS_PASSWORD@127.0.0.1:6380/0

# Only for a deployment with NO Redis and exactly ONE worker process.
# Setting this with multiple workers silently multiplies every rate limit.
# RATE_LIMIT_SINGLE_INSTANCE=true

# ── Crypto ─────────────────────────────────────────────────────────────────
# Wraps per-tenant keys for TOTP secrets and integration credentials.
# Generate:
#   python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# BACK THIS UP OFF-MACHINE BEFORE STORING ANYTHING UNDER IT. There is no
# recovery: lose it and every TOTP secret and integration credential becomes
# permanently undecryptable.
ENCRYPTION_MASTER_KEY=

# ── Two-factor authentication ──────────────────────────────────────────────
# TEMPORARY: false lets every account, including superusers, sign in with a
# password alone. No challenge, no enrolment demand, and an already-enrolled
# factor is ignored (but NOT deleted — flipping this back to true restores the
# challenge with no re-enrolment needed).
#
# The enrolment screen now exists (Account -> Two-factor authentication), so
# keep this true. The API logs a warning on every boot while it is off.
MFA_ENFORCED=true

# Whether an owner / admin / superuser with NO factor enrolled is REFUSED.
#
# Users can now enrol for themselves: with this true, an owner/admin with no
# factor is sent to the enrolment screen at sign-in instead of being let in on
# a password alone. Recommended for production once the frontend with the
# enrolment screen is deployed. An administrator can reset a user's factor
# (lost phone) from Users -> the user -> Reset two-factor.
#
# This is separate from MFA_ENFORCED on purpose. With it false, anyone who HAS
# a factor is still challenged for it; only enrolment is optional.
MFA_REQUIRE_ENROLMENT=false

# ── Public API (Vercel frontend) ───────────────────────────────────────────
# Set PUBLIC_API=true when this API is reachable from the internet, i.e. the
# frontend runs on Vercel and calls api.suliko.ge. Startup then REQUIRES
# BFF_SHARED_SECRET.
PUBLIC_API=true

# Shared secret the frontend sends in the X-Suliko-Gateway header. Requests
# without it get a flat 404. Defence in depth, not authentication — sessions,
# permissions and tenancy are all still enforced behind it.
# Generate the same way as ENCRYPTION_MASTER_KEY.
# The identical value goes into Vercel as BFF_SHARED_SECRET.
BFF_SHARED_SECRET=

# ── CORS ───────────────────────────────────────────────────────────────────
# The Vercel frontends' public origins. Production refuses any non-loopback
# http:// origin. JSON array, quoted. The suliko.ge origins are for the
# translator portal, whose browsers upload and download order files directly
# with signed tickets.
CORS_ORIGINS=["https://app.suliko.ge","https://suliko.ge","https://www.suliko.ge","https://suliko.io","https://www.suliko.io"]

# ── Outbound auth email ────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. The API refuses to start without SMTP_HOST and
# SMTP_FROM_EMAIL, because POST /auth/password/forgot answers 204 whether or
# not the account exists — it must, or it enumerates users — so an
# unconfigured mailer tells every locked-out person that their reset link is
# on its way and then silently drops it.
#
# This is the PLATFORM relay, used only for account mail: password resets,
# invites, and confirming a new signup's email address. A bureau's own SMTP
# (Settings -> Integrations) still sends its business mail, because that has
# to come from the bureau's address.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on 587 (the usual choice). For implicit TLS on 465, set
# SMTP_STARTTLS=false and SMTP_SSL=true instead.
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_FROM_EMAIL=noreply@suliko.ge
SMTP_FROM_NAME=Suliko

# Public base URL of the frontend. Reset links are built from it, and it must
# be https in production. NEVER derived from the request's Host header — that
# is attacker-controlled, and a poisoned reset link is account takeover.
APP_URL=https://app.suliko.ge

# suliko.ge's own base URL — a DIFFERENT site from APP_URL above. An invite
# that matches no suliko.ge account is emailed a registration link built from
# this, telling them exactly which address to sign up with.
SULIKO_SITE_URL=https://suliko.ge

# How long a reset link stays usable.
# PASSWORD_RESET_TTL_MINUTES=60

# Invitations: staff invites email a single-use set-password link (no
# password is ever emailed). Per-organisation daily cap on invites, because
# each one is mail from this platform's address with text the bureau wrote.
# INVITE_LINK_TTL_HOURS=168

# Email verification: signup mails a single-use confirmation link. Nothing is
# blocked on it today (see User.email_verified_at) — it exists so the app can
# show and mean "confirm your address". Resends are capped per account, not
# per IP: only the signed-in owner of the account can ask for one.
# EMAIL_VERIFICATION_TTL_HOURS=72
# EMAIL_VERIFICATION_RESEND_MAX=5
# EMAIL_VERIFICATION_RESEND_WINDOW_SECONDS=3600

# Self sign-up (POST /auth/signup). Off: people join by an organisation's
# invitation, and open their personal account from the sign-in chooser. Keep
# it in step with SIGNUP_ENABLED on the frontend.
# SIGNUP_ENABLED=false
# INVITE_MAX_PER_TENANT=30

# ── Translator portal (suliko.ge) ──────────────────────────────────────────
# HMAC key shared with the suliko.ge Next.js server, where the SAME value goes
# in as SULIKO_PORTAL_SECRET. It signs which suliko.ge user is acting, so it
# must be long and random (32+ characters; production refuses shorter). Generate
# the same way as ENCRYPTION_MASTER_KEY. Empty disables the portal.
PORTAL_SHARED_SECRET=

# ── suliko.ge sign-in ──────────────────────────────────────────────────────
# People registered on suliko.ge sign in to Suliko Office with the SAME email or
# phone number and password, which suliko.ge's backend checks — Office never
# stores it. Set both to turn that on; leave SULIKO_API_URL unset and Office
# signs people in on its own passwords alone.
#
# SULIKO_API_URL is the suliko.ge backend's origin (no trailing slash).
# SULIKO_API_KEY must equal "Office": { "ApiKey": ... } in that backend's
# appsettings.json; it unlocks the read-only user directory, never passwords.
# Production requires https and a key of 24+ characters.
# SULIKO_API_URL=https://content.api24.ge
# SULIKO_API_KEY=
# SULIKO_API_TIMEOUT_SECONDS=10
# Where the "reset your password" email sends people whose password lives on
# suliko.ge. Keep it on the same site as SULIKO_SITE_URL in the frontend.
# SULIKO_PASSWORD_RESET_URL=https://suliko.ge/login

# Personal-order files are stored in the database; order files go to the
# storage below. Both are capped (bytes).
# PERSONAL_FILE_MAX_BYTES=26214400
# ORDER_FILE_MAX_BYTES=52428800

# ── Order file storage ─────────────────────────────────────────────────────
# Suliko stores every bureau's order files itself — no bureau sets anything up.
# Unset: order data works, but nothing can be uploaded or downloaded.
#
# Option 1: a folder on THIS server. Keep it on an encrypted drive (BitLocker),
# OUTSIDE the code directory, and include it in the nightly backup together
# with the database — the rows say what each file is, the folder holds it.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=D:\suliko-files
#
# Option 2: any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2,
# Hetzner Object Storage, MinIO). The key needs only PutObject, GetObject and
# DeleteObject on the bucket.
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com   # unset for AWS itself
# S3_REGION=eu-north-1                                  # R2: auto
# S3_BUCKET=suliko-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ADDRESSING_STYLE=path                              # or virtual
#
# Option 3: the Order Vault (encrypted; this API can store and delete files
# but can NEVER read them back — only the vault's team can open them, in the
# vault's own panel). Downloads here answer 409 "stored in the Order Vault".
# VAULT_SERVICE_KEY must equal `Vault:ServiceKey` in the vault's appsettings.
# STORAGE_BACKEND=vault
# VAULT_URL=https://vault.suliko.ge
# VAULT_SERVICE_KEY=
# Files stored BEFORE the switch stay readable/purgeable from where they are
# (uses STORAGE_LOCAL_DIR or the S3_* settings):
# STORAGE_LEGACY_BACKEND=local
# Note the vault deletes client source files itself after its own retention
# (183 days by default); a row here can outlive its bytes.
#
# Removed files stay restorable this long, then `python -m suliko.cli
# purge-files` (scheduled daily) deletes their bytes.
# FILE_RETENTION_DAYS=30

# ── Optional tuning ────────────────────────────────────────────────────────
# SESSION_IDLE_TIMEOUT_MINUTES=30
# SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# STEP_UP_MAX_AGE_MINUTES=5
# LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=5
# LOGIN_MAX_ATTEMPTS_PER_IP=20
# MFA_MAX_ATTEMPTS=5
# WRITE_MAX_PER_MINUTE=120
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_ECHO=false                  # NEVER true in production — logs query parameters
