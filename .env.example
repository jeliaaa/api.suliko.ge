# ---------------------------------------------------------------------------
# Suliko CRM API — environment
#
# Copy to .env for local development. NEVER commit a filled-in .env.
# See docs/03-SECURITY-AND-TENANCY.md §6 for the secret-handling rules.
# ---------------------------------------------------------------------------

ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # must be false in production

# ── Database ───────────────────────────────────────────────────────────────
# Must use the asyncpg driver; startup refuses anything else.
DATABASE_URL=postgresql+asyncpg://suliko:suliko@localhost:5432/suliko

# ── Redis ──────────────────────────────────────────────────────────────────
# Rate-limit counters. Optional in development (falls back to an in-process
# limiter, correct for ONE instance only). Production refuses to start without it.
REDIS_URL=redis://localhost:6379/0

# ── Crypto ─────────────────────────────────────────────────────────────────
# Wraps per-tenant data keys for TOTP secrets and integration credentials.
# Generate:
#   python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Rotating this invalidates every stored secret — plan a re-encrypt.
ENCRYPTION_MASTER_KEY=

# ── CORS ───────────────────────────────────────────────────────────────────
# Only the Next.js BFF calls this API. Keep the list narrow; production
# refuses to start if any entry is http://.
CORS_ORIGINS=["http://localhost:3000"]

# ── Session / step-up timings (optional overrides) ─────────────────────────
# SESSION_IDLE_TIMEOUT_MINUTES=30
# SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# STEP_UP_MAX_AGE_MINUTES=5
