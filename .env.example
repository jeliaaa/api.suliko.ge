# ===========================================================================
# Suliko CRM API — environment
#
# Copy to `.env` in this directory. NEVER commit a filled-in `.env`.
#
# This ONE file is read by two things:
#   - the application (pydantic-settings)
#   - docker compose, for the POSTGRES_* / REDIS_* values below
#
# So the database password you set here is both what Docker creates the server
# with AND what the app connects with. Change it in one place.
#
# Third-party service keys (Google Drive, Bank of Georgia, SMS, ElevenLabs,
# API24, reCAPTCHA) do NOT belong here. They are per-tenant, entered through
# Settings -> Integrations, and stored encrypted in the database.
# See docs/EXTERNAL-SERVICES.md §3.
# ===========================================================================

# ── Environment ────────────────────────────────────────────────────────────
ENVIRONMENT=production           # development | staging | production
DEBUG=false                      # must be false in production

# ── Docker: PostgreSQL ─────────────────────────────────────────────────────
# Host ports default to NON-standard values (5433 / 6380) so they cannot
# collide with a PostgreSQL or Redis already running on this server. Change
# them only if those are taken too. Both bind to 127.0.0.1 only.
POSTGRES_USER=suliko
POSTGRES_PASSWORD=               # generate a long random password
POSTGRES_DB=suliko
POSTGRES_HOST_PORT=5433

# ── Docker: Redis ──────────────────────────────────────────────────────────
REDIS_PASSWORD=                  # generate a long random password
REDIS_HOST_PORT=6380

# ── Application: database ──────────────────────────────────────────────────
# Must use the asyncpg driver and must match the POSTGRES_* values above,
# including the host port.
DATABASE_URL=postgresql+asyncpg://suliko:SAME-AS-POSTGRES_PASSWORD@127.0.0.1:5433/suliko

# ── Application: Redis ─────────────────────────────────────────────────────
# Must match REDIS_PASSWORD and REDIS_HOST_PORT above.
# With Redis configured, do NOT set RATE_LIMIT_SINGLE_INSTANCE.
REDIS_URL=redis://:SAME-AS-REDIS_PASSWORD@127.0.0.1:6380/0

# Only for a deployment with NO Redis and exactly ONE worker process.
# Setting this with multiple workers silently multiplies every rate limit.
# RATE_LIMIT_SINGLE_INSTANCE=true

# ── Crypto ─────────────────────────────────────────────────────────────────
# Wraps per-tenant keys for TOTP secrets and integration credentials.
# Generate:
#   python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# BACK THIS UP OFF-MACHINE BEFORE STORING ANYTHING UNDER IT. There is no
# recovery: lose it and every TOTP secret and integration credential becomes
# permanently undecryptable.
ENCRYPTION_MASTER_KEY=

# ── Two-factor authentication ──────────────────────────────────────────────
# TEMPORARY: false lets every account, including superusers, sign in with a
# password alone. No challenge, no enrolment demand, and an already-enrolled
# factor is ignored (but NOT deleted — flipping this back to true restores the
# challenge with no re-enrolment needed).
#
# Set this back to true as soon as the enrolment screen exists. The API logs a
# warning on every boot while it is off.
MFA_ENFORCED=false

# ── Public API (Vercel frontend) ───────────────────────────────────────────
# Set PUBLIC_API=true when this API is reachable from the internet, i.e. the
# frontend runs on Vercel and calls api.suliko.ge. Startup then REQUIRES
# BFF_SHARED_SECRET.
PUBLIC_API=true

# Shared secret the frontend sends in the X-Suliko-Gateway header. Requests
# without it get a flat 404. Defence in depth, not authentication — sessions,
# permissions and tenancy are all still enforced behind it.
# Generate the same way as ENCRYPTION_MASTER_KEY.
# The identical value goes into Vercel as BFF_SHARED_SECRET.
BFF_SHARED_SECRET=

# ── CORS ───────────────────────────────────────────────────────────────────
# The Vercel frontend's public origin. Production refuses any non-loopback
# http:// origin. JSON array, quoted.
CORS_ORIGINS=["https://app.suliko.ge"]

# ── Optional tuning ────────────────────────────────────────────────────────
# SESSION_IDLE_TIMEOUT_MINUTES=30
# SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# STEP_UP_MAX_AGE_MINUTES=5
# LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=5
# LOGIN_MAX_ATTEMPTS_PER_IP=20
# MFA_MAX_ATTEMPTS=5
# WRITE_MAX_PER_MINUTE=120
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_ECHO=false                  # NEVER true in production — logs query parameters
